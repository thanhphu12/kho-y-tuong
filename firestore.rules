rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ideas/{id} {
      allow read: if true;
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.author is string
                    && request.resource.data.author.size() <= 60
                    && request.resource.data.description.size() <= 3000
                    && request.resource.data.voters.size() == 0;
      allow update: if request.resource.data.title == resource.data.title
                    && request.resource.data.author == resource.data.author;
      allow delete: if true;
    }
  }
}
